# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Server-only: used by app/api/* route handlers to reach the FastAPI backend.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix; the browser only ever
# calls this Next.js app's own /api/* routes).

# ContextStore API key (csk_live_...). Sent as `Authorization: Bearer <key>`;
# the backend derives tenant_id from it, so the frontend never sends a tenant.
CONTEXTSTORE_API_KEY=

# Backend base URL. Point at the hosted backend once deployed.
CONTEXTSTORE_API_URL=http://localhost:8000

# Operator admin UI kill switch. Unset (or anything other than "false") serves
# /admin as normal -- the default. Set to "false" on any PUBLIC-facing
# deployment to 404 /admin and the /api/admin/* proxy entirely. Read at request
# time, so it can be flipped per deployment without a rebuild. See
# docs/deployment.md ("Admin UI hardening").
# ENABLE_ADMIN_UI=false
