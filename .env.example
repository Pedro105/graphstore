# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Both required: ANTHROPIC_API_KEY for extraction (Claude Haiku), OPENAI_API_KEY
# for embeddings (text-embedding-3-small).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EXTRACTION_MODEL=claude-haiku-4-5-20251001
VECTOR_MERGE_THRESHOLD=0.92
VECTOR_CANDIDATE_THRESHOLD=0.80

# Auth: Postgres (Supabase) connection + operator admin token. DATABASE_URL is
# an asyncpg DSN, e.g. postgresql://user:pass@host:5432/postgres. When unset,
# the /v1/ routes refuse requests (503) since tenant_id can't be resolved.
# ADMIN_TOKEN guards the operator-only /v1/keys management endpoints.
# NEVER put real values here -- this file is committed. Real values live in
# .env (gitignored) locally and in `fly secrets` in production.
DATABASE_URL=postgresql://postgres:CHANGEME@db.YOUR_PROJECT.supabase.co:5432/postgres
ADMIN_TOKEN=generate-with-openssl-rand-hex-32

# Per-API-key rate limits (requests/minute), enforced in-process per key.
RATE_LIMIT_RECALL=60
RATE_LIMIT_MEMORIES=30

# CORS allow-list (comma-separated origins). The frontend's origin must be
# listed here. Defaults to the Next.js dev server; add the deployed frontend
# URL here (in prod, set via `fly secrets`/env) without a code change.
ALLOWED_ORIGINS=http://localhost:3000

# MCP server (src/contextstore/mcp_server/) -- only needed when running
# `contextstore-mcp`. CONTEXTSTORE_API_KEY is the ContextStore API key
# (csk_live_...) the server sends as `Authorization: Bearer <key>` on every
# call; the tenant is derived from that key server-side, never sent by the MCP.
CONTEXTSTORE_API_URL=http://localhost:8000
CONTEXTSTORE_API_KEY=
